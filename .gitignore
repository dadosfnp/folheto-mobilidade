# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Output — PDFs gerados e previews de QA (renders PNG página a página,
# gerados ad-hoc pra revisão visual, nunca artefato final). Nada aqui vai
# pro git: distribuição é por GitHub Release (mesmo padrão do folheto-ifem,
# ver CLAUDE.md).
output/*.pdf
output/_preview_*
!output/.gitkeep

# Fontes (binárias — usuário baixa local com tools/baixar_fontes.py)
fonts/*.ttf
fonts/*.otf
!fonts/README.md

# Back-office Django — arquivo temporário do save atômico (ver
# web/municipios/armazenamento.py::salvar_atomico); só sobrevive a uma
# falha no meio da escrita, nunca deveria ser commitado.
data/mobilidade/*.json.tmp

# Dado bruto/externo de origem (SIH, SIM, SENATRAN, IBGE, RM…) usado por
# tools/dados_tratados_para_json.py para gerar os JSONs de
# data/mobilidade/*.json — ~7 GB, nunca cabe (nem deveria) no git. Convenção:
#   data/raw/       — extração original imutável (SIH, SIM em parquet)
#   data/external/  — dado de referência de terceiros (planilhas auxiliares)
# Cada dev/máquina mantém sua própria cópia local.
data/raw/
data/external/

# Harness Claude Code (local)
.claude/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
